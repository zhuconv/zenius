{
  "name": "zenius",
  "version": "0.1.4",
  "description": "Node SDK and CLI for zenius (Agentic Zen). Bring your agent to your browser.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "zenius": "bin/zenius"
  },
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node build.mjs && node --test --test-reporter=dot \"test/**/*.test.ts\"",
    "test:integration": "scripts/test-integration.sh",
    "coverage:protocol": "node scripts/protocol-coverage.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
